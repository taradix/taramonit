location / {
    set $upstream http://taramonit-frontend;
    proxy_pass       $upstream;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
}

location /nginx_status {
    stub_status on;
    access_log off;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
}

location /api/ {
    set $upstream http://taramonit-api;
    proxy_pass       $upstream;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
}

location = /alertmanager {
    return 301 /alertmanager/;
}

location /alertmanager/ {
    set $upstream http://taramonit-alertmanager:9093/;
    proxy_pass       $upstream;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
}

location = /grafana {
    return 301 /grafana/;
}

location /grafana/ {
    set $upstream http://taramonit-grafana:3000/;
    proxy_pass       $upstream;
    proxy_set_header Host      $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_redirect off;
}
